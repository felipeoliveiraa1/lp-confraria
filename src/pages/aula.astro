---
import Base from '../layouts/Base.astro';
// Cópia da /aberta/ com a VSL nova (vid-6a5553b46bb281f2af61f70d).
// VSL + botão que só aparece após 13:55 de vídeo (mesmo gate da home).
const CHECKOUT = 'https://checkout.payt.com.br/5ecd76cef086597a75e716faf73aa445?split=12';
---
<Base>
  <!-- gate: esconde o botão até o play completar 13:55. Roda antes da pintura (sem flash).
       Sem JS / com ?preview, nada é escondido. -->
  <script is:inline>try{if(!localStorage.getItem('al_aula_revealed')&&!/[?&]preview/.test(location.search))document.documentElement.classList.add('gated')}catch(e){document.documentElement.classList.add('gated')}</script>

  <!-- ============ HERO (aula) ============ -->
  <header class="hero" style="background-image:url(/assets/hero-bg.webp)">
    <div class="wrap--narrow">
      <h1 class="hero-title">
        EXISTE UM MÉTODO ONDE O <span class="green">LUCRO VEM ANTES DA TEORIA</span> — E OS RESULTADOS SÃO REAIS
      </h1>
      <!-- ===== VSL — player nativo do vturb (carrega no load = play-rate real) ===== -->
      <div class="vsl-slot" id="vsl">
        <img class="vsl-poster" src="/assets/vsl-cover-aula.webp" alt="" fetchpriority="high" decoding="async" width="270" height="480" />
        <vturb-smartplayer id="vid-6a5553b46bb281f2af61f70d" style="display:block;width:100%;height:100%"></vturb-smartplayer>
      </div>
      <script is:inline>
        /* adia o player p/ logo após o 1º paint (fora da janela do LCP): no máx 2s (requestIdleCallback)
           ou na 1ª interação. Ainda carrega p/ todos que ficam >~1s = play-rate real preservado. */
        (function(){var SRC='https://scripts.converteai.net/d9544c5d-ba21-4c7b-aa65-b6663bf5494d/players/6a5553b46bb281f2af61f70d/v4/player.js',done=false;function load(){if(done)return;done=true;var s=document.createElement('script');s.src=SRC;s.async=true;document.head.appendChild(s);}if('requestIdleCallback' in window){requestIdleCallback(load,{timeout:2000});}else{setTimeout(load,1500);}['pointerdown','touchstart','scroll','keydown'].forEach(function(e){addEventListener(e,load,{once:true,passive:true});});})();
      </script>

      <div class="gate" id="hero-cta">
        <p class="cupom mt-m">CUPOM LIBERADO</p>
        <div class="cta-wrap"><a class="btn" href="#" onclick="openCheckoutPopup(event)">QUERO TER ACESSO AGORA</a></div>
      </div>
    </div>
  </header>

  <!-- Checkout Popup Modal -->
  <div id="checkout-popup" class="popup-overlay" style="display:none">
    <div class="popup-content">
      <button class="popup-close" onclick="closePopup()">&times;</button>
      <h2 class="popup-title">Complete seus dados</h2>
      <p class="popup-subtitle">para garantir sua vaga</p>
      <form id="checkout-form" onsubmit="submitCheckout(event)">
        <div class="form-group">
          <label for="full_name">Nome completo</label>
          <input type="text" id="full_name" name="full_name" placeholder="Seu nome completo" required>
        </div>
        <div class="form-group">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" placeholder="seu@email.com" required>
        </div>
        <div class="form-group">
          <label for="phone">Telefone</label>
          <input type="tel" id="phone" name="phone" placeholder="(00) 00000-0000" required>
        </div>
        <button type="submit" class="btn-popup">FINALIZAR INSCRIÇÃO</button>
      </form>
    </div>
  </div>

  <script is:inline>
    function adjustEmail(email) {
      if (!email) return email;
      var parts = email.split('@');
      if (parts.length !== 2) return email;
      var local = parts[0];
      var domain = parts[1];
      if (domain.toLowerCase().endsWith('.br')) return email;
      return local + '@' + domain + '.br';
    }

    function openCheckoutPopup(e) {
      e.preventDefault();
      document.getElementById('checkout-popup').style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closePopup() {
      document.getElementById('checkout-popup').style.display = 'none';
      document.body.style.overflow = '';
    }

    function submitCheckout(e) {
      e.preventDefault();
      var fullName = document.getElementById('full_name').value.trim();
      var rawEmail = document.getElementById('email').value.trim();
      var phone = document.getElementById('phone').value.trim();

      if (!fullName || !rawEmail || !phone) {
        alert('Preencha todos os campos');
        return;
      }

      var email = adjustEmail(rawEmail);
      var checkoutUrl = 'https://checkout.payt.com.br/5ecd76cef086597a75e716faf73aa445?split=12';
      var separator = checkoutUrl.includes('?') ? '&' : '?';
      var finalUrl = checkoutUrl + separator + 'full_name=' + encodeURIComponent(fullName) + '&email=' + encodeURIComponent(email) + '&phone=' + encodeURIComponent(phone);

      window.location.href = finalUrl;
    }

    document.addEventListener('click', function(e) {
      var popup = document.getElementById('checkout-popup');
      if (e.target === popup) closePopup();
    });
  </script>

  <style>
  .popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    padding: 20px;
  }
  .popup-content {
    background: linear-gradient(180deg, #0d1a0d, #050a05);
    border: 1px solid #1eff00;
    border-radius: 20px;
    padding: 36px 28px;
    max-width: 420px;
    width: 100%;
    position: relative;
    box-shadow: 0 0 60px rgba(30, 255, 0, 0.2);
    animation: popupIn 0.3s ease;
  }
  @keyframes popupIn {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  .popup-close {
    position: absolute;
    top: 14px;
    right: 18px;
    background: none;
    border: none;
    color: #666;
    font-size: 32px;
    cursor: pointer;
    line-height: 1;
  }
  .popup-close:hover { color: #fff; }
  .popup-title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 26px;
    color: #fff;
    text-align: center;
    margin-bottom: 4px;
  }
  .popup-subtitle {
    font-family: var(--font-head);
    color: #1eff00;
    text-align: center;
    margin-bottom: 28px;
    font-size: 16px;
  }
  .form-group {
    margin-bottom: 18px;
  }
  .form-group label {
    display: block;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 13px;
    color: #aaa;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .form-group input {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid #333;
    border-radius: 10px;
    background: #111;
    color: #fff;
    font-size: 16px;
    font-family: var(--font-body);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .form-group input:focus {
    outline: none;
    border-color: #1eff00;
    box-shadow: 0 0 12px rgba(30, 255, 0, 0.2);
  }
  .form-group input::placeholder { color: #555; }
  .btn-popup {
    width: 100%;
    padding: 18px;
    background: linear-gradient(180deg, #3dff45, #10c437);
    border: none;
    border-radius: 60px;
    color: #04250a;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    margin-top: 10px;
    transition: transform 0.15s, filter 0.15s;
  }
  .btn-popup:hover {
    filter: brightness(1.1);
    transform: scale(1.02);
  }
  </style>

  <!-- reveal: botão aparece quando o VÍDEO chega em 13:55 (currentTime real do player
       vturb). ?preview revela na hora (QA). Persiste. Fail-open se o player não carregar. -->
  <script is:inline>
    (function () {
      var PITCH = 13 * 60 + 55; // 13:55 = 835s de vídeo
      var KEY = 'al_aula_revealed', iv = null, t0 = Date.now(), saw = false;
      function reveal() {
        document.documentElement.classList.remove('gated');
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
        if (iv) { clearInterval(iv); iv = null; }
      }
      function vtime() { try { var a = (window.smartplayer && window.smartplayer.instances) || []; for (var i = 0; i < a.length; i++) { var t = a[i] && a[i].instance && a[i].instance.currentTime; if (typeof t === 'number' && isFinite(t)) return t; } } catch (e) {} return -1; }
      function check() { var t = vtime(); if (t >= 0) saw = true; if (t >= PITCH) return reveal(); if (!saw && Date.now() - t0 > 30000) reveal(); }
      try { if (/[?&]preview/.test(location.search)) { document.documentElement.classList.remove('gated'); return; } } catch (e) {}
      try { if (localStorage.getItem(KEY)) { reveal(); return; } } catch (e) {}
      iv = setInterval(check, 1000);
    })();
  </script>

  <footer class="foot">
    <p>Operar mercados alavancados envolve risco real de perda.</p>
    <p style="margin-top:8px">MATCHUP TREINAMENTOS LTDA - ME - CNPJ 43.108.423/0001-32</p>
  </footer>
</Base>
