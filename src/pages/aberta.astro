---
import Base from '../layouts/Base.astro';
// Versão "aberta" com TESTE A/B de VSL (vturb ab-test 6a559424…):
//   FRONT        6a3d1ec9ac7ae1f31843b4c4 -> pitch 13:52
//   FRONT ANTIGO 6a444b0f4395e2f407d1fb96 -> pitch 18:03
// O gate detecta qual variante o A/B carregou e usa o tempo certo.
const CHECKOUT = 'https://checkout.payt.com.br/5ecd76cef086597a75e716faf73aa445?split=12';
---
<Base>
  <!-- gate: esconde o botão até o play completar 13:55. Roda antes da pintura (sem flash).
       Sem JS / com ?preview, nada é escondido. -->
  <script is:inline>try{if(!localStorage.getItem('al_aberta_revealed')&&!/[?&]preview/.test(location.search))document.documentElement.classList.add('gated')}catch(e){document.documentElement.classList.add('gated')}</script>

  <!-- ============ HERO (aberta) ============ -->
  <header class="hero" style="background-image:url(/assets/hero-bg.webp)">
    <div class="wrap--narrow">
      <h1 class="hero-title">
        EXISTE UM MÉTODO ONDE O <span class="green">LUCRO VEM ANTES DA TEORIA</span> — E OS RESULTADOS SÃO REAIS
      </h1>
      <!-- ===== VSL — player nativo do TESTE A/B do vturb (carrega no load = play-rate real) ===== -->
      <div class="vsl-slot" id="vsl">
        <img class="vsl-poster" src="/assets/vsl-cover-aberta.webp" alt="" fetchpriority="high" decoding="async" width="460" height="818" />
        <vturb-smartplayer id="ab-6a55942439ad7d1bd452174c" style="display:block;width:100%;height:100%"></vturb-smartplayer>
      </div>
      <script is:inline>
        /* adia o player p/ logo após o 1º paint (fora da janela do LCP): no máx 2s (requestIdleCallback)
           ou na 1ª interação. Ainda carrega p/ todos que ficam >~1s = play-rate real preservado. */
        (function(){var SRC='https://scripts.converteai.net/d9544c5d-ba21-4c7b-aa65-b6663bf5494d/ab-test/6a55942439ad7d1bd452174c/player.js',done=false;function load(){if(done)return;done=true;var s=document.createElement('script');s.src=SRC;s.async=true;document.head.appendChild(s);}if('requestIdleCallback' in window){requestIdleCallback(load,{timeout:2000});}else{setTimeout(load,1500);}['pointerdown','touchstart','scroll','keydown'].forEach(function(e){addEventListener(e,load,{once:true,passive:true});});})();
      </script>

      <div class="gate" id="hero-cta">
        <p class="cupom mt-m">CUPOM LIBERADO</p>
        <div class="cta-wrap"><a class="btn" href={CHECKOUT}>QUERO TER ACESSO AGORA</a></div>
      </div>
    </div>
  </header>

  <!-- reveal A/B: CTA aparece quando o VÍDEO chega no pitch da variante sorteada
       (FRONT 6a3d1ec9 -> 13:52 · FRONT ANTIGO 6a444b0f -> 18:03). Lê o currentTime real
       do player + a variante escolhida (localStorage vturb-ab-<testId>). Até saber a
       variante usa o maior tempo. Fail-open se o player não carregar. ?preview p/ QA. -->
  <script is:inline>
    (function () {
      var AB_KEY = 'vturb-ab-6a55942439ad7d1bd452174c';
      var VAR_A = '6a3d1ec9ac7ae1f31843b4c4', PITCH_A = 13 * 60 + 52; // FRONT (nova): 13:52
      var VAR_B = '6a444b0f4395e2f407d1fb96', PITCH_B = 18 * 60 + 3;  // FRONT ANTIGO: 18:03
      var PITCH = Math.max(PITCH_A, PITCH_B); // até detectar a variante, usa o maior
      var KEY = 'al_aberta_revealed', iv = null, t0 = Date.now(), saw = false;
      function reveal() { document.documentElement.classList.remove('gated'); try { localStorage.setItem(KEY, '1'); } catch (e) {} if (iv) { clearInterval(iv); iv = null; } }
      function applyPitch() { var v = null; try { v = localStorage.getItem(AB_KEY); } catch (e) {} if (v === VAR_A) PITCH = PITCH_A; else if (v === VAR_B) PITCH = PITCH_B; }
      function vtime() { try { var a = (window.smartplayer && window.smartplayer.instances) || []; for (var i = 0; i < a.length; i++) { var t = a[i] && a[i].instance && a[i].instance.currentTime; if (typeof t === 'number' && isFinite(t)) return t; } } catch (e) {} return -1; }
      function check() { applyPitch(); var t = vtime(); if (t >= 0) saw = true; if (t >= PITCH) return reveal(); if (!saw && Date.now() - t0 > 30000) reveal(); }
      try { if (/[?&]preview/.test(location.search)) { document.documentElement.classList.remove('gated'); return; } } catch (e) {}
      try { if (localStorage.getItem(KEY)) { reveal(); return; } } catch (e) {}
      iv = setInterval(check, 1000);
    })();
  </script>

  <footer class="foot">
    <p>Operar mercados alavancados envolve risco real de perda.</p>
    <p style="margin-top:8px">MATCHUP TREINAMENTOS LTDA - ME - CNPJ 43.108.423/0001-32</p>
  </footer>
</Base>
